#!/bin/sh /etc/rc.common
# procd init script for meow-rs.
# Service settings live in /etc/config/meow (UCI); the proxy configuration
# itself is the regular meow YAML file (default /etc/meow/config.yaml).

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/meow
GATEWAY=/usr/share/meow/gateway.sh
SECRET_DIR=/var/run/meow
SECRET_FILE=$SECRET_DIR/controller-secret

validate_with_controller_secret() (
	incoming_secret=$1
	shift
	LC_ALL=C
	case "$incoming_secret" in *[![:print:]]|*' ') return 1 ;; esac
	umask 077
	[ ! -L "$SECRET_DIR" ] && mkdir -p "$SECRET_DIR" && chmod 700 "$SECRET_DIR" || return 1
	temp_secret=$(mktemp "$SECRET_DIR/controller-secret.XXXXXX") || return 1
	trap 'rm -f "$temp_secret"' EXIT
	printf '%s\n' "$incoming_secret" >"$temp_secret" || return 1
	# Keep the current runtime file available to procd until the new config passes.
	"$PROG" "$@" --secret-file "$temp_secret" -t && mv -f "$temp_secret" "$SECRET_FILE"
)

start_service() {
	local enabled config_file work_dir panel_port secret tproxy controller

	config_load meow
	config_get_bool enabled main enabled 0
	config_get config_file main config_file /etc/meow/config.yaml
	config_get work_dir main work_dir /etc/meow
	config_get panel_port main panel_port 9090
	config_get secret main secret ''
	config_get_bool tproxy tproxy enabled 0

	if [ "$enabled" -ne 1 ]; then
		rm -f "$SECRET_FILE"
		return
	fi
    [ "$config_file" = /etc/meow/config.yaml ] && [ "$work_dir" = /etc/meow ] || {
        logger -t meow 'managed service requires /etc/meow/config.yaml and work_dir /etc/meow'
        return 1
    }

	controller="127.0.0.1:$panel_port"
	set -- --no-external-plugins -d "$work_dir" -f "$config_file"
	if [ -n "$secret" ]; then
		if ! validate_with_controller_secret "$secret" "$@" >/dev/null 2>&1; then
			logger -t meow "config or controller credential check failed for $config_file, not starting"
			return 1
		fi
		# procd keeps the path available for automatic respawns.
		set -- "$@" --secret-file "$SECRET_FILE"
		controller="0.0.0.0:$panel_port"
	else
		if ! "$PROG" "$@" -t >/dev/null 2>&1; then
			logger -t meow "config test failed for $config_file, not starting"
			return 1
		fi
		rm -f "$SECRET_FILE" || return 1
	fi

	procd_open_instance meow
	procd_set_param command "$PROG" "$@" --ext-ctl "$controller"
	# Restart when the service settings, YAML, or the effective secret change.
	procd_set_param file /etc/config/meow "$config_file"
	[ -z "$secret" ] || procd_append_param file "$SECRET_FILE"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="1000000 1000000"
	procd_close_instance

	if [ "$tproxy" -eq 1 ]; then
        # A supervised instance owns the wait and rules, including teardown.
        procd_open_instance gateway
        procd_set_param command "$GATEWAY" run
        procd_set_param term_timeout 5
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
	else
		"$GATEWAY" down
	fi
}

stop_service() {
	"$GATEWAY" down
	case "${1:-}" in
		''|meow) rm -f "$SECRET_FILE" ;;
	esac
}

service_triggers() {
	procd_add_reload_trigger "meow"
}

reload_service() {
	stop
	start
}

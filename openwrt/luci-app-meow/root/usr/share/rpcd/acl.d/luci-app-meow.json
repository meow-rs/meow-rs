{
	"luci-app-meow": {
		"description": "Grant access to meow service configuration",
		"read": {
			"uci": [ "meow", "network" ],
			"ubus": {
				"service": [ "list" ]
			},
			"file": {
				"/etc/meow/*": [ "read" ],
				"/sbin/logread -e meow": [ "exec" ],
				"/usr/share/meow/gateway.sh status": [ "exec" ],
				"/usr/share/meow/arp-hijack.sh clients": [ "exec" ]
			}
		},
		"write": {
			"uci": [ "meow" ],
			"file": {
				"/etc/meow/*": [ "write" ],
				"/tmp/meow-luci-check.yaml": [ "write" ],
				"/tmp/meow-luci-settings-*.yaml": [ "write" ],
				"/usr/bin/meow -d * -f /tmp/meow-luci-settings-*.yaml -t": [ "exec" ],
				"/usr/bin/meow -d * -f /tmp/meow-luci-check.yaml -t": [ "exec" ],
				"/etc/init.d/meow restart": [ "exec" ],
				"/etc/init.d/meow-arp restart": [ "exec" ]
			}
		}
	}
}

{
	"luci-app-meow": {
		"description": "Grant access to meow service configuration",
		"read": {
			"uci": [ "meow", "network" ],
			"ubus": {
				"service": [ "list" ],
				"file": [ "exec" ],
				"uci": [ "get", "changes" ]
			},
			"file": {
				"/sbin/logread -e meow": [ "exec" ],
				"/usr/share/meow/gateway.sh status": [ "exec" ],
				"/usr/share/meow/arp-hijack.sh clients": [ "exec" ],
				"/usr/libexec/meow-api GET /version": [ "exec" ],
				"/usr/libexec/meow-api GET /configs": [ "exec" ],
				"/usr/libexec/meow-api GET /connections": [ "exec" ],
				"/etc/meow/config.yaml": [ "read" ]
			},
			"cgi-io": [ "download", "exec" ]
		},
		"write": {
			"uci": [ "meow" ],
			"file": {
				"/tmp/meow-luci-check.yaml": [ "write" ],
				"/tmp/meow-luci-settings-*.yaml": [ "write" ],
				"/etc/init.d/meow restart": [ "exec" ],
				"/etc/init.d/meow-arp restart": [ "exec" ],
				"/usr/libexec/meow-api PATCH /configs *": [ "exec" ],
				"/etc/meow/config.yaml": [ "write" ],
				"/usr/libexec/meow-validate *": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec", "remove" ],
				"uci": [ "add", "apply", "confirm", "delete", "order", "rename", "set" ]
			},
			"cgi-io": [ "upload" ]
		}
	}
}
